/**
 * Helper function to get the currency symbol.
 */
function _simplecrm_get_currency_symbol($node) {
  $allowed_values = $node->getFieldDefinition('field_currency')->getFieldStorageDefinition()->getSetting('allowed_values');
  $node_value = $node->get('field_currency')->value;
  return $allowed_values[$node_value];
}

/**
 * Helper function to get the currency symbol.
 */
function _simplecrm_generic_get_currency_symbol($node_in_question, $field_name = 'field_currency') {
  $allowed_values = $node_in_question->getFieldDefinition('field_currency')->getFieldStorageDefinition()->getSetting('allowed_values');
  $node_value = $node_in_question->get($field_name)->value;
  return $allowed_values[$node_value];
}

/**
 * Helper function to populate a `chargeable_gigs` array element.
 */
function _simplecrm_get_chargeable_gigs(Node $this_gig) {
  $field_name = 'field_currency'; // Replace with your field name
  // $field_definition = $this_gig->{$field_name}->getFieldDefinition()->getFieldStorageDefinition();
  // $options = options_allowed_values($field_definition, $this_gig);
  // $field_value = $this_gig->get($field_name)->value;
  // $field_currency_label = $options[$field_value];
  $field_currency_label = _simplecrm_generic_get_currency_symbol($this_gig, $field_name);
  $chargeable_gig = [
    'title' => $this_gig->getTitle(),
    'body' => $this_gig->get('body')->value,
    'time_spent' => $this_gig->get('field_time_spent')->value,
    'rate' => $this_gig->get('field_rate')->value,
    'total' => number_format($this_gig->get('field_rate')->value * $this_gig->get('field_time_spent')->value, 2),
    'currency' => $field_currency_label,
    'time_unit' => substr(strtolower($this_gig->get('field_time_unit')->value), 0, -1),
  ];
  return $chargeable_gig;
}

/**
 * Helper function to get the expenses.
 */
function _simplecrm_get_expenses(Node $this_chargeable_work) {
  $field_name = 'field_currency'; // Replace with your field name
  $field_currency_label = _simplecrm_generic_get_currency_symbol($this_chargeable_work, $field_name);
  $expenses = [];
  // Get all expenses that reference this chargeable work.
  $query = \Drupal::entityQuery('node')
    ->condition('type', 'expense')
    ->condition('uid', \Drupal::currentUser()->id())
    ->condition('field_job', $this_chargeable_work->id() )
    ->accessCheck(FALSE);
  $nids = $query->execute();
  // dump($nids);
  foreach ($nids as $expense) {
    $expense_node = Node::load($expense);
    // dump($expense_node->getTitle());
    $expense_data = [
      'title' => $expense_node->getTitle(),
      'body' => $expense_node->get('body')->value,
      'price' => $expense_node->get('field_price')->value,
      'currency' => _simplecrm_generic_get_currency_symbol($expense_node, $field_name),
    ];
    $expenses[] = $expense_data;
  }
  return $expenses;
}
