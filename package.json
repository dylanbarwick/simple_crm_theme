{
  "name": "simple_crm_theme",
  "private": true,
  "scripts": {
    "build": "npx tailwindcss -i ./src/css/main.css -o ./dist/css/output.css",
    "livereload": "livereload --exclusions node_modules/ --exts 'css,js,twig,theme,apng,avif,gif,jpg,jpeg,jfif,pjpeg,pjp,png,svg,webp'"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "livereload": "^0.9.3",
    "postcss": "^8.4.38",
    "postcss-import": "^16.1.0",
    "postcss-import-ext-glob": "^2.1.1",
    "tailwindcss": "^3.4.3",
    "webpack": "^5.91.0"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}
